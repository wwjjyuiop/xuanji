# ─────────────────────────────────────────────
# 玄机 GUI 配置模板
# 复制为 .env 后填入自己的密钥（.env 不要提交到仓库）
# ─────────────────────────────────────────────

# ── 主推理：DeepSeek 官方 API ─────────────
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-************************

# ── 多模态：阿里云通义千问（看图用）──────
# 申请地址：https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-************************
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 可选：本地模型（Ollama）────────────────
# 填 1 则主推理走本地 http://127.0.0.1:11434/v1
USE_LOCAL_MODEL=0

# ── 可选：百度语音识别 ────────────────────
# 申请地址：https://console.bce.baidu.com/ → 语音技术
BAIDU_APP_ID=****************
BAIDU_API_KEY=****************
BAIDU_SECRET_KEY=****************

# ── 可选：QQ 机器人 ───────────────────────
QQ_APP_ID=****************
QQ_CLIENT_SECRET=****************
QQ_SANDBOX=0
